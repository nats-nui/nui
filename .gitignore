# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

.idea


db
db_bak
credentials
# Insecure TLS certs for tests: track only the dedicated set, ignore anything else.
tests/certs_insecure/**
!tests/certs_insecure/tests-ca.pem
!tests/certs_insecure/tests-server-cert.pem
!tests/certs_insecure/tests-server-key.pem
!tests/certs_insecure/tests-client-cert.pem
!tests/certs_insecure/tests-client-key.pem
build/*
!build/.gitkeep
!build/appicon.png

cmd/test

protoschemas/*
!protoschemas/.gitkeep